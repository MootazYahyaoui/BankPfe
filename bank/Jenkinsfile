pipeline {
  agent any

  options {
    timestamps()
  }

  parameters {
    string(name: 'DOCKERHUB_USERNAME', defaultValue: '', description: 'Docker Hub username (required if PUSH_IMAGES=true)')
    booleanParam(name: 'PUSH_IMAGES', defaultValue: false, description: 'Push images to Docker Hub')
    booleanParam(name: 'DEPLOY_MINIKUBE', defaultValue: false, description: 'Deploy to Minikube after image push')
    booleanParam(name: 'SKIP_TESTS', defaultValue: false, description: 'Si coché: mvn -DskipTests (utile si les tests nécessitent une infra locale)')
  }

  environment {
    IMAGE_TAG = "${env.BUILD_NUMBER}"
    MINIKUBE_PROFILE = "jenkins-ci"
    MINIKUBE_HOME = "/var/lib/jenkins/.minikube"
    KUBECONFIG_PATH = "/var/lib/jenkins/.kube/config"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Backend Build') {
      steps {
        dir('bank') {
          script {
            if (params.SKIP_TESTS) {
              sh 'mvn -DskipTests clean package'
            } else {
              sh 'mvn clean package'
            }
          }
        }
      }
    }

    stage('Frontend Build') {
      steps {
        dir('bank/front') {
          sh 'npm ci || npm install'
          sh 'npm run build'
        }
      }
    }

    stage('Docker Build') {
      steps {
        dir('bank') {
          sh '''
            IMAGE_PREFIX=${DOCKERHUB_USERNAME:-local}
            docker build -t ${IMAGE_PREFIX}/discovery-service:${IMAGE_TAG} discovery-service
            docker build -t ${IMAGE_PREFIX}/gateway-service:${IMAGE_TAG} gateway-service
            docker build -t ${IMAGE_PREFIX}/authentication-service:${IMAGE_TAG} authentication-service
            docker build -t ${IMAGE_PREFIX}/customer-service:${IMAGE_TAG} customer-service
            docker build -t ${IMAGE_PREFIX}/account-service:${IMAGE_TAG} account-service
            docker build -t ${IMAGE_PREFIX}/notification-service:${IMAGE_TAG} notification-service
            docker build -t ${IMAGE_PREFIX}/bank-frontend:${IMAGE_TAG} front
          '''
        }
      }
    }

    stage('Docker Push') {
      when {
        expression { return params.PUSH_IMAGES && params.DOCKERHUB_USERNAME?.trim() }
      }
      steps {
        withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
          sh '''
            IMAGE_PREFIX=${DOCKERHUB_USERNAME}
            docker login -u "$DOCKER_USER" -p "$DOCKER_PASS"

            docker push ${IMAGE_PREFIX}/discovery-service:${IMAGE_TAG}
            docker push ${IMAGE_PREFIX}/gateway-service:${IMAGE_TAG}
            docker push ${IMAGE_PREFIX}/authentication-service:${IMAGE_TAG}
            docker push ${IMAGE_PREFIX}/customer-service:${IMAGE_TAG}
            docker push ${IMAGE_PREFIX}/account-service:${IMAGE_TAG}
            docker push ${IMAGE_PREFIX}/notification-service:${IMAGE_TAG}
            docker push ${IMAGE_PREFIX}/bank-frontend:${IMAGE_TAG}
          '''
        }
      }
    }

    stage('Deploy to Minikube') {
      when {
        expression { return params.DEPLOY_MINIKUBE && params.PUSH_IMAGES && params.DOCKERHUB_USERNAME?.trim() }
      }
      options {
        timeout(time: 45, unit: 'MINUTES')
      }
      stages {
        stage('K8s: cluster up') {
          steps {
            dir('bank') {
              sh '''
                export MINIKUBE_HOME=${MINIKUBE_HOME}
                export KUBECONFIG=${KUBECONFIG_PATH}
                /usr/local/bin/minikube -p ${MINIKUBE_PROFILE} start --memory=2048
                /usr/local/bin/minikube -p ${MINIKUBE_PROFILE} update-context
                kubectl config use-context ${MINIKUBE_PROFILE}
                kubectl version --client
                kubectl get nodes
              '''
            }
          }
        }
        stage('K8s: Ingress ready') {
          steps {
            dir('bank') {
              sh '''
                export MINIKUBE_HOME=${MINIKUBE_HOME}
                export KUBECONFIG=${KUBECONFIG_PATH}
                kubectl config use-context ${MINIKUBE_PROFILE}
                echo "Ensuring ingress addon is enabled..."
                /usr/local/bin/minikube -p ${MINIKUBE_PROFILE} addons enable ingress
                echo "Waiting for ingress-nginx controller..."
                kubectl -n ingress-nginx rollout status deployment/ingress-nginx-controller --timeout=300s
                echo "Waiting for ingress-nginx-controller-admission endpoints..."
                i=0
                while [ "$i" -lt 120 ]; do
                  ADDRS=$(kubectl get endpoints -n ingress-nginx ingress-nginx-controller-admission -o jsonpath='{.subsets[*].addresses[*].ip}' 2>/dev/null || true)
                  if [ -n "$ADDRS" ]; then
                    echo "Admission endpoints: OK"
                    break
                  fi
                  i=$((i + 1))
                  if [ $((i % 15)) -eq 0 ]; then echo "  ... still waiting ($i/120)"; fi
                  sleep 2
                done
                sleep 15
                WH=$(kubectl get validatingwebhookconfiguration -o name 2>/dev/null | grep -i ingress | head -1 || true)
                if [ -n "$WH" ]; then
                  kubectl patch "$WH" --type=json \
                    -p='[{"op":"replace","path":"/webhooks/0/timeoutSeconds","value":30}]' 2>/dev/null || true
                fi
              '''
            }
          }
        }
        stage('K8s: apply manifests') {
          steps {
            dir('bank') {
              sh '''
                export MINIKUBE_HOME=${MINIKUBE_HOME}
                export KUBECONFIG=${KUBECONFIG_PATH}
                kubectl config use-context ${MINIKUBE_PROFILE}
                echo "Applying k8s manifests (retry if admission webhook is slow)..."
                APPLY_OK=0
                for attempt in 1 2 3 4 5 6; do
                  if kubectl apply -f k8s/ && ( shopt -s nullglob; for f in k8s/monitoring/*.yaml k8s/monitoring/*.yml; do kubectl apply -f "$f"; done; shopt -u nullglob ); then
                    APPLY_OK=1
                    break
                  fi
                  echo "kubectl apply failed (attempt $attempt/6), waiting 45s..."
                  kubectl -n ingress-nginx rollout status deployment/ingress-nginx-controller --timeout=120s || true
                  sleep 45
                done
                if [ "$APPLY_OK" != "1" ]; then
                  echo "kubectl apply failed after retries"
                  exit 1
                fi
              '''
            }
          }
        }
        stage('K8s: rollout images') {
          steps {
            dir('bank') {
              sh '''
                export MINIKUBE_HOME=${MINIKUBE_HOME}
                export KUBECONFIG=${KUBECONFIG_PATH}
                kubectl config use-context ${MINIKUBE_PROFILE}
                IMAGE_PREFIX=${DOCKERHUB_USERNAME}
                kubectl -n bank set image deployment/discovery-service discovery-service=${IMAGE_PREFIX}/discovery-service:${IMAGE_TAG}
                kubectl -n bank set image deployment/gateway-service gateway-service=${IMAGE_PREFIX}/gateway-service:${IMAGE_TAG}
                kubectl -n bank set image deployment/authentication-service authentication-service=${IMAGE_PREFIX}/authentication-service:${IMAGE_TAG}
                kubectl -n bank set image deployment/customer-service customer-service=${IMAGE_PREFIX}/customer-service:${IMAGE_TAG}
                kubectl -n bank set image deployment/account-service account-service=${IMAGE_PREFIX}/account-service:${IMAGE_TAG}
                kubectl -n bank set image deployment/notification-service notification-service=${IMAGE_PREFIX}/notification-service:${IMAGE_TAG}
                kubectl -n bank set image deployment/bank-frontend bank-frontend=${IMAGE_PREFIX}/bank-frontend:${IMAGE_TAG}
                ROLLOUT_TO=480s
                kubectl -n bank rollout status deployment/discovery-service --timeout=${ROLLOUT_TO}
                kubectl -n bank rollout status deployment/gateway-service --timeout=${ROLLOUT_TO}
                kubectl -n bank rollout status deployment/authentication-service --timeout=${ROLLOUT_TO}
                kubectl -n bank rollout status deployment/customer-service --timeout=${ROLLOUT_TO}
                kubectl -n bank rollout status deployment/account-service --timeout=${ROLLOUT_TO}
                kubectl -n bank rollout status deployment/notification-service --timeout=${ROLLOUT_TO}
                kubectl -n bank rollout status deployment/bank-frontend --timeout=${ROLLOUT_TO}
              '''
            }
          }
        }
      }
    }
  }

  post {
    success {
      echo 'Build backend + frontend termine avec succes.'
    }
    failure {
      echo 'Build echoue. Verifier Console Output.'
    }
  }
}